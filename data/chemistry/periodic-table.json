  "view": "periodic-table",
  "attributes": [
    {
      "key": "symbol",
      "label": "Symbol",
      "summary": "A one- or two-letter abbreviation for the element. The first letter is capitalized and the second, if any, is lowercase.",
      "points": [
        "Many symbols come from old Latin names: Fe (ferrum, iron), Au (aurum, gold), Na (natrium, sodium), K (kalium, potassium), Ag (argentum, silver), Pb (plumbum, lead), Hg (hydrargyrum, mercury)."
      ]
    },
    {
      "key": "number",
      "label": "Atomic number",
      "summary": "The number of protons in the nucleus of an atom. It is written Z, and it is what makes an element that element.",
      "points": [
        "Change the number of protons and you change the element: every carbon atom has 6 protons, every oxygen atom has 8.",
        "A neutral atom has the same number of electrons as protons.",
        "The periodic table is ordered by atomic number, not by mass."
      ]
    },
    {
      "key": "mass",
      "label": "Atomic mass",
      "summary": "The average mass of an atom of the element, measured in unified atomic mass units (u). One u is one twelfth of the mass of a carbon-12 atom.",
      "points": [
        "It is a weighted average over the isotopes found in nature, so it is rarely a whole number. Chlorine is 35.45 because about 76% of chlorine atoms are chlorine-35 and about 24% are chlorine-37.",
        "Roughly, it equals protons plus neutrons, because electrons weigh almost nothing.",
        "A whole number in brackets, such as (98) for technetium, means the element has no stable isotope. The number shown is the mass number of its longest-lived known isotope."
      ]
    },
    {
      "key": "category",
      "label": "Family",
      "summary": "A family is a set of elements that behave in similar ways. Which family an element belongs to depends on its position and on how it reacts. Sources draw the borders slightly differently; these are the ones used here.",
      "items": [
        {
          "term": "Alkali metals",
          "text": "Group 1 except hydrogen. Soft, shiny and very reactive, with one outer electron. They react vigorously with water."
        },
        {
          "term": "Alkaline earth metals",
          "text": "Group 2. Harder and less reactive than the alkali metals, with two outer electrons."
        },
        {
          "term": "Transition metals",
          "text": "Groups 3 to 12, the d-block. Hard, dense, good conductors, often with several oxidation states and colored compounds."
        },
        {
          "term": "Post-transition metals",
          "text": "Metals to the right of the transition metals, such as aluminium, tin and lead. Softer and with lower melting points."
        },
        {
          "term": "Metalloids",
          "text": "Boron, silicon, germanium, arsenic, antimony and tellurium. They sit between metals and nonmetals, and many are semiconductors."
        },
        {
          "term": "Reactive nonmetals",
          "text": "Hydrogen, carbon, nitrogen, oxygen, phosphorus, sulfur and selenium. They gain or share electrons when they bond, and they are central to biology."
        },
        {
          "term": "Halogens",
          "text": "Group 17. Seven outer electrons and very reactive. They form salts with metals."
        },
        {
          "term": "Noble gases",
          "text": "Group 18. A full outer shell makes them almost completely unreactive."
        },
        {
          "term": "Lanthanides",
          "text": "Elements 57 to 71. Silvery f-block metals with very similar chemistry. With scandium and yttrium they are called the rare earths."
        },
        {
          "term": "Actinides",
          "text": "Elements 89 to 103. All are radioactive. Uranium and plutonium are the best known."
        }
      ]
    },
    {
      "key": "group",
      "label": "Group",
      "summary": "A group is a column of the table, numbered 1 to 18 from left to right.",
      "points": [
        "Elements in the same main group have the same number of outer (valence) electrons, so they react in similar ways.",
        "The lanthanides and actinides are drawn as two separate rows underneath and have no group number of their own. Lutetium and lawrencium are listed as group 3."
      ]
    },
    {
      "key": "period",
      "label": "Period",
      "summary": "A period is a row of the table, numbered 1 to 7 from top to bottom.",
      "points": [
        "The period number is the number of electron shells that hold electrons in the atom. Sodium is in period 3, so its electrons occupy three shells.",
        "Properties change steadily across a period, and the pattern repeats in the next one.",
        "The periods have 2, 8, 8, 18, 18, 32 and 32 elements."
      ]
    },
    {
      "key": "block",
      "label": "Block",
      "summary": "The block (s, p, d or f) names the type of subshell that the last electron added to the atom goes into.",
      "points": [
        "s-block: groups 1 and 2, plus helium.",
        "p-block: groups 13 to 18, except helium.",
        "d-block: groups 3 to 12, the transition metals.",
        "f-block: the lanthanides and actinides.",
        "Helium is in the s-block because its two electrons fill the 1s orbital, even though it is placed with the noble gases."
      ]
    },
    {
      "key": "config",
      "label": "Electron configuration",
      "summary": "The configuration lists which orbitals hold the electrons of a neutral atom. Each entry is a shell number, a subshell letter and a small number for how many electrons it holds.",
      "points": [
        "2p4 means four electrons in the 2p subshell.",
        "A subshell holds at most 2 (s), 6 (p), 10 (d) or 14 (f) electrons.",
        "Orbitals fill from low energy to high: 1s, 2s, 2p, 3s, 3p, 4s, 3d, 4p and so on.",
        "[Ne] or [Ar] is shorthand for the electrons of that noble gas, so only the outer electrons need to be written.",
        "Some elements break the pattern. Chromium is [Ar] 3d5 4s1 and copper is [Ar] 3d10 4s1, because half-filled and full d subshells are especially stable."
      ]
    },
    {
      "key": "state",
      "label": "State at room temperature",
      "summary": "Whether the element is a solid, liquid or gas at about 20 to 25 °C and normal air pressure.",
      "points": [
        "Most elements are solids.",
        "Two are liquids: bromine and mercury. Gallium melts at about 30 °C, so it is just solid.",
        "Eleven are gases: hydrogen, helium, nitrogen, oxygen, fluorine, neon, chlorine, argon, krypton, xenon and radon.",
        "\"Unknown\" means it has not been measured, which is the case for the heaviest elements."
      ]
    },
    {
      "key": "melt",
      "label": "Melting point",
      "summary": "The temperature at which the solid turns into a liquid at normal pressure. It is shown in kelvin (K) and in degrees Celsius.",
      "points": [
        "°C = K − 273.15. Zero kelvin is absolute zero.",
        "Tungsten has the highest melting point of the metals, 3695 K.",
        "Carbon does not melt at normal pressure. It sublimes, going straight from solid to gas.",
        "Helium does not freeze at normal pressure at all, so no value is given."
      ]
    },
    {
      "key": "boil",
      "label": "Boiling point",
      "summary": "The temperature at which the liquid turns into a gas at normal pressure (1 atmosphere). It is shown in kelvin and in degrees Celsius.",
      "points": [
        "It reflects how strongly the atoms or molecules attract each other. Strong attraction means a high boiling point.",
        "Helium has the lowest, 4.2 K. Rhenium and tungsten are among the highest.",
        "Arsenic sublimes instead of boiling at normal pressure, so the value shown is its sublimation temperature."
      ]
    },
    {
      "key": "density",
      "label": "Density",
      "summary": "Mass per unit of volume. Solids and liquids are given in grams per cubic centimetre (g/cm³). Gases are given in grams per litre (g/L) at 0 °C and 1 atmosphere.",
      "points": [
        "Water is 1 g/cm³ for comparison.",
        "Osmium is the densest element, about 22.6 g/cm³. Hydrogen is the lightest."
      ]
    },
    {
      "key": "eneg",
      "label": "Electronegativity",
      "summary": "How strongly an atom pulls on the electrons it shares in a bond. The Pauling scale runs from about 0.7 to 3.98.",
      "points": [
        "Fluorine is the highest at 3.98. Caesium and francium are among the lowest.",
        "It generally rises from left to right across a period and from bottom to top down a group.",
        "A big difference between two atoms gives an ionic bond. A small difference gives a covalent bond.",
        "Most noble gases have no value because they hardly bond."
      ]
    },
    {
      "key": "discovered",
      "label": "Discovered",
      "summary": "The year the element was first identified or isolated.",
      "points": [
        "\"Ancient\" means it has been known since antiquity with no single discoverer, for example gold, iron, copper, silver, tin and lead.",
        "Some dates are disputed, and the heaviest elements are credited to the labs that first made them."
      ]
    }
  ],
